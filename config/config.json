{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "kpi-metric-cards-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/kpiMetricCards/KpiMetricCardsWebPart.js",
          "manifest": "./src/webparts/kpiMetricCards/KpiMetricCardsWebPart.manifest.json"
        }
      ]
    },
    "esg-feedback-widget-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/esgFeedbackWidget/EsgFeedbackWidgetWebPart.js",
          "manifest": "./src/webparts/esgFeedbackWidget/EsgFeedbackWidgetWebPart.manifest.json"
        }
      ]
    },
    "supplier-esg-search-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/supplierEsgSearch/SupplierEsgSearchWebPart.js",
          "manifest": "./src/webparts/supplierEsgSearch/SupplierEsgSearchWebPart.manifest.json"
        }
      ]
    },
    "questionnaire-quick-links-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/questionnaireQuickLinks/QuestionnaireQuickLinksWebPart.js",
          "manifest": "./src/webparts/questionnaireQuickLinks/QuestionnaireQuickLinksWebPart.manifest.json"
        }
      ]
    },
    "supplier-sustainability-dashboard-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/supplierSustainabilityDashboard/SupplierSustainabilityDashboardWebPart.js",
          "manifest": "./src/webparts/supplierSustainabilityDashboard/SupplierSustainabilityDashboardWebPart.manifest.json"
        }
      ]
    },
    "completed-questionnaires-tab-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/completedQuestionnairesTab/CompletedQuestionnairesTabWebPart.js",
          "manifest": "./src/webparts/completedQuestionnairesTab/CompletedQuestionnairesTabWebPart.manifest.json"
        }
      ]
    },
    "supporting-documents-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/supportingDocuments/SupportingDocumentsWebPart.js",
          "manifest": "./src/webparts/supportingDocuments/SupportingDocumentsWebPart.manifest.json"
        }
      ]
    },
    "esg-dashboard-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/esgDashboard/EsgDashboardWebPart.js",
          "manifest": "./src/webparts/esgDashboard/EsgDashboardWebPart.manifest.json"
        }
      ]
    },
    "help-page-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/helpPage/HelpPageWebPart.js",
          "manifest": "./src/webparts/helpPage/HelpPageWebPart.manifest.json"
        }
      ]
    },
    "supplier-navigation-application-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/supplierNavigation/SupplierNavigationApplicationCustomizer.js",
          "manifest": "./src/extensions/supplierNavigation/SupplierNavigationApplicationCustomizer.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "KpiMetricCardsWebPartStrings": "lib/webparts/kpiMetricCards/loc/{locale}.js",
    "EsgFeedbackWidgetWebPartStrings": "lib/webparts/esgFeedbackWidget/loc/{locale}.js",
    "SupplierEsgSearchWebPartStrings": "lib/webparts/supplierEsgSearch/loc/{locale}.js",
    "QuestionnaireQuickLinksWebPartStrings": "lib/webparts/questionnaireQuickLinks/loc/{locale}.js",
    "SupplierSustainabilityDashboardWebPartStrings": "lib/webparts/supplierSustainabilityDashboard/loc/{locale}.js",
    "CompletedQuestionnairesTabWebPartStrings": "lib/webparts/completedQuestionnairesTab/loc/{locale}.js",
    "SupportingDocumentsWebPartStrings": "lib/webparts/supportingDocuments/loc/{locale}.js",
    "EsgDashboardWebPartStrings": "lib/webparts/esgDashboard/loc/{locale}.js",
    "HelpPageWebPartStrings": "lib/webparts/helpPage/loc/{locale}.js",
    "SupplierNavigationApplicationCustomizerStrings": "lib/extensions/supplierNavigation/loc/{locale}.js"
  }
}
